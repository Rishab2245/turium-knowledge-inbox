# Copy to server/.env (or export these) before starting the API.
# Everything has a working default; the app runs with none of them set.

# ---- Model provider -------------------------------------------------------
# Leave OPENAI_API_KEY unset to run fully offline: embeddings fall back to a
# local hashed model and answers are extracted from the retrieved text rather
# than generated. Set it for semantic search and synthesised answers.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works: Google Gemini, Groq, Together,
# OpenRouter, Ollama, vLLM. Leave blank for api.openai.com.
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Optional. Only sent when set. gemini-embedding-001 and text-embedding-3-*
# can return a shorter vector, which shrinks the index and speeds up the scan.
EMBEDDING_DIMENSIONS=

# --- Google Gemini (verified working on the free tier) ---------------------
# Gemini exposes an OpenAI-compatible surface, so no code changes are needed:
#
#   OPENAI_API_KEY=<your AI Studio key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   EMBEDDING_MODEL=gemini-embedding-001
#   CHAT_MODEL=gemini-3.1-flash-lite
#
# Pick a non-reasoning chat model. Gemini 3.x "flash" models spend their output
# budget on hidden thinking tokens and return HTTP 200 with empty content;
# flash-lite does not think and answers normally.
#
# gemini-embedding-001 returns 3072 dimensions, already L2-normalised. That is
# 2x the memory and scan cost of text-embedding-3-small for the brute-force
# search. Set EMBEDDING_DIMENSIONS=768 to trade a little accuracy for a 4x
# smaller index.
#
# Free-tier quotas are low. Budget roughly one request per ingested item and
# two per question (one embedding + one chat).

# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
DATABASE_PATH=./data/knowledge-inbox.db

# ---- Chunking and retrieval ----------------------------------------------
CHUNK_SIZE_CHARS=1100
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_TOP_K=6
MIN_RELEVANCE_SCORE=0.05

# ---- Ingestion limits -----------------------------------------------------
INGEST_CONCURRENCY=2
MAX_JOB_ATTEMPTS=3
URL_FETCH_TIMEOUT_MS=15000
MAX_URL_BYTES=2000000
MAX_NOTE_CHARS=100000
