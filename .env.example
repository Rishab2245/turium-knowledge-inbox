# Copy to server/.env before starting the API.
# Everything has a working default; the app runs with none of these set.

# ---- Model provider -------------------------------------------------------
# Set ONE key. Everything else below is optional.
#
# Google Gemini has a free tier, so it is the path of least resistance:
# create a key at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=

# Or use OpenAI instead. If both are set, Gemini wins.
OPENAI_API_KEY=

# With neither key the app still runs: embeddings fall back to a local hashed
# model and answers are extracted from the retrieved text rather than
# generated. The UI says so, prominently.

# ---- Provider overrides (all optional) ------------------------------------
# Sensible per-provider defaults are applied automatically:
#
#   GEMINI_API_KEY -> gemini-embedding-001  +  gemini-3.1-flash-lite
#   OPENAI_API_KEY -> text-embedding-3-small + gpt-4o-mini
#
# Override only if you want something else.
EMBEDDING_MODEL=
CHAT_MODEL=

# Point at any OpenAI-compatible endpoint: Groq, Together, OpenRouter, Ollama,
# vLLM. Overrides the provider default base URL.
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1          (Ollama)
OPENAI_BASE_URL=

# Optional. gemini-embedding-001 defaults to 3072 dimensions; 768 or 1536 give
# a proportionally smaller index and faster scan for a little accuracy.
EMBEDDING_DIMENSIONS=

# On Gemini, prefer a "flash-lite" chat model. The 3.x flash and pro models
# reason before answering: hidden thinking tokens eat the output budget and the
# call returns HTTP 200 with empty content. The server warns at boot if the
# configured model looks like one of those.

# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
DATABASE_PATH=./data/knowledge-inbox.db

# ---- Chunking and retrieval ----------------------------------------------
CHUNK_SIZE_CHARS=1100
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_TOP_K=6
MIN_RELEVANCE_SCORE=0.05

# ---- Ingestion limits -----------------------------------------------------
INGEST_CONCURRENCY=2
MAX_JOB_ATTEMPTS=3
URL_FETCH_TIMEOUT_MS=15000
MAX_URL_BYTES=2000000
MAX_NOTE_CHARS=100000
